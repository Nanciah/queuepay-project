import React, { useState, useEffect } from 'react';
import { useNavigate, useLocation } from 'react-router-dom';
import { useAuth } from '../../context/AuthContext';
import { useSocket } from '../../context/SocketContext';
import toast from 'react-hot-toast';
import { companyAdmin } from '../../services/api';
import {
  LayoutDashboard,
  Building2,
  Users,
  User,

  Settings,
  LogOut,
  UserCog,
  Ticket,
  Clock,
  BarChart3,
  ClipboardList,
  FileText,
  CreditCard,
} from 'lucide-react';

const Sidebar = () => {
  const { user, logout } = useAuth();
  const navigate = useNavigate();
  const location = useLocation();
  const { socket, isConnected, emit, on, off } = useSocket();

  const [waitingCount, setWaitingCount] = useState(0);
  const [currentServiceId, setCurrentServiceId] = useState(null);
  const [currentServiceName, setCurrentServiceName] = useState('File d\'attente');
  const [services, setServices] = useState([]);
  const [loadingServices, setLoadingServices] = useState(true);

  const isActive = (path) => location.pathname.startsWith(path);

  const handleLogout = () => {
    logout();
    navigate('/login');
  };

  // ========== RÉCUPÉRER LES SERVICES DE L'AGENT ==========
  const fetchAgentServices = async () => {
    try {
      setLoadingServices(true);
      console.log('🔄 [Sidebar] Récupération des services de l\'agent...');
      
      const response = await companyAdmin.getAgentServices();
      console.log('✅ [Sidebar] Services reçus:', response.data);
      
      setServices(response.data || []);
      
      if (response.data && response.data.length > 0) {
        const firstService = response.data[0];
        setCurrentServiceId(firstService.id);
        setCurrentServiceName(firstService.name);
        
        // Récupérer le nombre en attente
        fetchWaitingCount(firstService.id);
      } else {
        console.warn('⚠️ [Sidebar] Aucun service assigné');
      }
    } catch (error) {
      console.error('❌ [Sidebar] Erreur récupération services:', error);
    } finally {
      setLoadingServices(false);
    }
  };

  // ========== CHARGER LE NOMBRE DE CLIENTS EN ATTENTE ==========
  const fetchWaitingCount = async (serviceId) => {
    try {
      const response = await fetch(`http://localhost:5000/api/company/agent/queue/${serviceId}/status`, {
        headers: {
          'Authorization': `Bearer ${localStorage.getItem('token')}`,
        },
      });
      const data = await response.json();
      if (data && data.waiting !== undefined) {
        setWaitingCount(data.waiting);
        console.log(`📊 [Sidebar] Clients en attente: ${data.waiting}`);
      }
    } catch (error) {
      console.error('❌ [Sidebar] Erreur chargement waiting count:', error);
    }
  };

  // ========== CHARGEMENT INITIAL ==========
  useEffect(() => {
    if (user?.role === 'agent') {
      fetchAgentServices();
    }
  }, [user]);

  // ========== WEBSOCKET - ÉCOUTER LES MISES À JOUR ==========
  useEffect(() => {
    if (!socket || !isConnected || !currentServiceId) {
      return;
    }

    console.log('📡 [Sidebar] Connexion WebSocket pour les notifications');

    const onQueueUpdate = (data) => {
      console.log('🔄 [Sidebar] Mise à jour de la queue reçue:', data);
      if (data && data.waitingCount !== undefined) {
        setWaitingCount(data.waitingCount);
      } else {
        fetchWaitingCount(currentServiceId);
      }
    };

    const onNewTicket = (data) => {
      console.log('🎫 [Sidebar] Nouveau ticket reçu !');
      setWaitingCount(prev => prev + 1);
    };

    const onTicketCompleted = (data) => {
      console.log('✅ [Sidebar] Ticket complété');
      setWaitingCount(prev => Math.max(0, prev - 1));
    };

    const onTicketCancelled = (data) => {
      console.log('❌ [Sidebar] Ticket annulé');
      setWaitingCount(prev => Math.max(0, prev - 1));
    };

    on('queue-updated', onQueueUpdate);
    on('new-ticket', onNewTicket);
    on('ticket-completed', onTicketCompleted);
    on('ticket-cancelled', onTicketCancelled);

    emit('join-queue-room', { serviceId: currentServiceId });

    return () => {
      off('queue-updated', onQueueUpdate);
      off('new-ticket', onNewTicket);
      off('ticket-completed', onTicketCompleted);
      off('ticket-cancelled', onTicketCancelled);
    };
  }, [socket, isConnected, currentServiceId]);

  // ========== NAVIGATION VERS LA FILE D'ATTENTE ==========
  const navigateToQueue = () => {
    if (currentServiceId) {
      console.log('📍 [Sidebar] Navigation vers file d\'attente avec serviceId:', currentServiceId);
      navigate('/agent/queue', { 
        state: { 
          serviceId: currentServiceId,
          serviceName: currentServiceName
        } 
      });
    } else {
      console.warn('⚠️ [Sidebar] Pas de serviceId disponible');
      toast.error('Aucun service assigné');
    }
  };

  // ========== MENUS ==========
  const superAdminMenu = [
    { icon: LayoutDashboard, label: 'Dashboard', path: '/super-admin/dashboard', group: 'Principal' },
    { icon: Building2, label: 'Entreprises', path: '/super-admin/companies', group: 'Principal' },
    { icon: Users, label: 'Utilisateurs', path: '/super-admin/users', group: 'Principal' },
    { icon: CreditCard, label: 'Transactions', path: '/super-admin/transactions', group: 'Principal' },
    { icon: Clock, label: "Files d'attente", path: '/super-admin/queues', group: 'Principal' },
    { icon: BarChart3, label: 'Statistiques', path: '/super-admin/stats', group: 'Analyse' },
    { icon: FileText, label: 'Rapports', path: '/super-admin/reports', group: 'Analyse' },
    { icon: Settings, label: 'Configuration', path: '/super-admin/settings', group: 'Système' },
  ];

  const companyAdminMenu = [
    { icon: LayoutDashboard, label: 'Dashboard', path: '/company-admin/dashboard', group: 'Principal' },
    { icon: ClipboardList, label: 'Services', path: '/company-admin/services', group: 'Principal' },
    { icon: UserCog, label: 'Agents', path: '/company-admin/agents', group: 'Principal' },
    { icon: Clock, label: "Files d'attente", path: '/company-admin/queues', group: 'Principal' },
    { icon: CreditCard, label: 'Transactions', path: '/company-admin/transactions', group: 'Principal' },
    { icon: BarChart3, label: 'Statistiques', path: '/company-admin/stats', group: 'Analyse' },
    { icon: Settings, label: 'Configuration', path: '/company-admin/settings', group: 'Système' },
  ];

  // ========== MENU AGENT AVEC BADGE ==========
  const agentMenu = [
    { 
      icon: LayoutDashboard, 
      label: 'Dashboard', 
      path: '/agent/dashboard', 
      group: 'Principal',
      onClick: () => navigate('/agent/dashboard')
    },
    { 
      icon: Ticket, 
      label: "File d'attente", 
      path: '/agent/queue', 
      group: 'Principal',
      badge: waitingCount,
      onClick: navigateToQueue
    },
    { 
      icon: Clock, 
      label: 'Historique', 
      path: '/agent/history', 
      group: 'Principal',
      onClick: () => navigate('/agent/history')
    },
    { 
    icon: User,  // N'oubliez pas d'importer User depuis lucide-react
    label: 'Mon profil', 
    path: '/agent/profile', 
    group: 'Principal',
    onClick: () => navigate('/agent/profile')
  },
];
 

  const getMenuItems = () => {
    switch (user?.role) {
      case 'super_admin':
        return superAdminMenu;
      case 'company_admin':
        return companyAdminMenu;
      case 'agent':
        return agentMenu;
      default:
        return [];
    }
  };

  const menuItems = getMenuItems();

  const getRoleLabel = () => {
    switch (user?.role) {
      case 'super_admin':
        return 'Super Administrateur';
      case 'company_admin':
        return 'Administrateur Entreprise';
      case 'agent':
        return 'Agent de Guichet';
      default:
        return 'Utilisateur';
    }
  };

  const getRoleBadge = () => {
    switch (user?.role) {
      case 'super_admin':
        return 'Super Admin';
      case 'company_admin':
        return 'Admin Entreprise';
      case 'agent':
        return 'Agent';
      default:
        return 'Utilisateur';
    }
  };

  const groupedItems = menuItems.reduce((acc, item) => {
    if (!acc[item.group]) acc[item.group] = [];
    acc[item.group].push(item);
    return acc;
  }, {});

  return (
    <div
      className="h-screen w-64 flex flex-col fixed left-0 top-0 z-50"
      style={{
        background: '#ffffff',
        borderRight: '1px solid #f1f5f9',
        boxShadow: '4px 0 24px rgba(0,0,0,0.04), 1px 0 2px rgba(0,0,0,0.02)',
      }}
    >
      {/* ===== LOGO ===== */}
      <div className="px-5 pt-5 pb-4">
        <div className="flex items-center gap-3">
          <div
            className="w-10 h-10 rounded-xl flex items-center justify-center"
            style={{
              background: 'linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #a855f7 100%)',
              boxShadow: '0 4px 12px rgba(99,102,241,0.3)',
            }}
          >
            <span className="text-xl">⏱️</span>
          </div>
          <div>
            <h1
              className="text-lg font-bold tracking-tight"
              style={{ color: '#111827', letterSpacing: '-0.3px' }}
            >
              QueuePay
            </h1>
            <p className="text-xs font-medium" style={{ color: '#6b7280' }}>
              {getRoleLabel()}
            </p>
          </div>
        </div>
      </div>

      {/* ===== CARTE UTILISATEUR ===== */}
      <div className="px-3 pb-3">
        <div
          className="flex items-center gap-3 p-3.5 rounded-xl transition-all duration-200"
          style={{
            background: 'linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%)',
            border: '1px solid #e2e8f0',
          }}
          onMouseEnter={(e) => {
            e.currentTarget.style.borderColor = '#c7d2fe';
            e.currentTarget.style.boxShadow = '0 2px 8px rgba(99,102,241,0.08)';
          }}
          onMouseLeave={(e) => {
            e.currentTarget.style.borderColor = '#e2e8f0';
            e.currentTarget.style.boxShadow = 'none';
          }}
        >
          <div
            className="w-10 h-10 rounded-full flex items-center justify-center text-white font-bold text-sm flex-shrink-0"
            style={{
              background: 'linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%)',
              boxShadow: '0 2px 8px rgba(79,70,229,0.25)',
            }}
          >
            {user?.firstName?.[0]}{user?.lastName?.[0]}
          </div>
          <div className="flex-1 min-w-0">
            <p className="text-sm font-semibold truncate" style={{ color: '#1e293b' }}>
              {user?.firstName} {user?.lastName}
            </p>
            <span
              className="inline-flex items-center gap-1.5 mt-1 px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider"
              style={{
                background: '#ede9fe',
                color: '#5b21b6',
              }}
            >
              <span
                className="w-1.5 h-1.5 rounded-full"
                style={{ background: '#7c3aed' }}
              />
              {getRoleBadge()}
            </span>
          </div>
        </div>
      </div>

      {/* ===== NAVIGATION ===== */}
      <nav className="flex-1 overflow-y-auto px-3 py-2 space-y-1">
        {Object.entries(groupedItems).map(([groupName, items], groupIndex) => (
          <div key={groupName}>
            {groupIndex > 0 && (
              <div
                className="my-3 mx-2"
                style={{
                  height: '1px',
                  background: 'linear-gradient(90deg, transparent, #e5e7eb, transparent)',
                }}
              />
            )}
            <div
              className="px-3 pb-1.5 pt-2 text-[10px] font-bold uppercase tracking-widest"
              style={{ color: '#94a3b8' }}
            >
              {groupName}
            </div>
            {items.map((item) => {
              const Icon = item.icon;
              const active = isActive(item.path);
              
              return (
                <button
                  key={item.path}
                  onClick={item.onClick || (() => navigate(item.path))}
                  className="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all duration-200 relative group"
                  style={{
                    background: active
                      ? 'linear-gradient(90deg, #ede9fe 0%, #f5f3ff 100%)'
                      : 'transparent',
                    color: active ? '#4f46e5' : '#475569',
                    transform: 'translateX(0)',
                  }}
                  onMouseEnter={(e) => {
                    if (!active) {
                      e.currentTarget.style.background = '#f8fafc';
                      e.currentTarget.style.transform = 'translateX(3px)';
                    }
                  }}
                  onMouseLeave={(e) => {
                    if (!active) {
                      e.currentTarget.style.background = 'transparent';
                      e.currentTarget.style.transform = 'translateX(0)';
                    }
                  }}
                >
                  {active && (
                    <span
                      className="absolute left-0 top-1/2 -translate-y-1/2 rounded-r-full"
                      style={{
                        width: '3px',
                        height: '20px',
                        background: 'linear-gradient(180deg, #6366f1, #8b5cf6)',
                      }}
                    />
                  )}

                  <span
                    className="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0 transition-all duration-200 relative"
                    style={{
                      background: active
                        ? 'linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%)'
                        : 'transparent',
                      boxShadow: active ? '0 2px 8px rgba(99,102,241,0.3)' : 'none',
                    }}
                  >
                    <Icon
                      className="w-[18px] h-[18px]"
                      strokeWidth={2}
                      style={{ color: active ? '#ffffff' : '#64748b' }}
                    />
                    
                    {item.badge && item.badge > 0 && (
                      <span
                        className="absolute -top-1 -right-1 flex items-center justify-center text-[9px] font-bold text-white rounded-full min-w-[18px] h-[18px] px-1 animate-pulse"
                        style={{
                          background: '#ef4444',
                          boxShadow: '0 2px 6px rgba(239,68,68,0.4)',
                          border: '2px solid white',
                        }}
                      >
                        {item.badge > 99 ? '99+' : item.badge}
                      </span>
                    )}
                  </span>

                  <span
                    className="text-[13.5px] font-medium transition-colors duration-200 flex-1 text-left"
                    style={{
                      color: active ? '#4f46e5' : '#475569',
                      fontWeight: active ? 600 : 500,
                    }}
                  >
                    {item.label}
                  </span>

                  {item.badge && item.badge > 0 && (
                    <span
                      className="text-xs font-bold px-2 py-0.5 rounded-full"
                      style={{
                        background: '#fee2e2',
                        color: '#dc2626',
                      }}
                    >
                      {item.badge}
                    </span>
                  )}
                </button>
              );
            })}
          </div>
        ))}
      </nav>

      {/* ===== DÉCONNEXION ===== */}
      <div
        className="p-3"
        style={{ borderTop: '1px solid #f1f5f9' }}
      >
        <button
          onClick={handleLogout}
          className="w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl transition-all duration-200"
          style={{
            background: 'linear-gradient(90deg, #fef2f2, #fff1f2)',
            border: '1px solid #fee2e2',
            color: '#dc2626',
          }}
          onMouseEnter={(e) => {
            e.currentTarget.style.background = 'linear-gradient(90deg, #fee2e2, #fecaca)';
            e.currentTarget.style.borderColor = '#fca5a5';
            e.currentTarget.style.transform = 'translateX(2px)';
          }}
          onMouseLeave={(e) => {
            e.currentTarget.style.background = 'linear-gradient(90deg, #fef2f2, #fff1f2)';
            e.currentTarget.style.borderColor = '#fee2e2';
            e.currentTarget.style.transform = 'translateX(0)';
          }}
        >
          <LogOut className="w-[18px] h-[18px]" strokeWidth={2} />
          <span className="text-[13.5px] font-medium">Déconnexion</span>
        </button>
      </div>
    </div>
  );
};

export default Sidebar;